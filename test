local animSaveFile = "SynapseHub_AnimPack.json"
local skipSavedAnimOnce = false

local function saveAnimPackToDisk(packName)
	pcall(function()
		if writefile then
			writefile(animSaveFile, HttpService:JSONEncode({ pack = packName or "" }))
		end
	end)
end

local function clearSavedAnimPackFromDisk()
	pcall(function()
		if delfile and isfile and isfile(animSaveFile) then
			delfile(animSaveFile)
		end
	end)
	pcall(function()
		if writefile then
			writefile(animSaveFile, HttpService:JSONEncode({ pack = "" }))
		end
	end)
end

local function loadAnimPackFromDisk()
	local savedPack = nil
	pcall(function()
		if readfile and isfile and isfile(animSaveFile) then
			local decoded = HttpService:JSONDecode(readfile(animSaveFile))
			if type(decoded) == "table" and type(decoded.pack) == "string" and decoded.pack ~= "" then
				savedPack = decoded.pack
			end
		end
	end)
	return savedPack
end

