-- Animasyon Pack Butonlarını Doldur
local ADIDAS_TOP_ORDER = { "Adidas Sports", "Adidas Community", "Adidas Aura" }
local adidasRank = {}
for i, n in ipairs(ADIDAS_TOP_ORDER) do adidasRank[n] = i end

local allPackNames = {}
for name in pairs(PACKS) do table.insert(allPackNames, name) end

table.sort(allPackNames, function(a, b)
	local ra, rb = adidasRank[a], adidasRank[b]
	if ra and rb then return ra < rb end
	if ra then return true end
	if rb then return false end
	return a:lower() < b:lower()
end)

local animButtonsByName = {}
for i, name in ipairs(allPackNames) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 26)
	btn.BackgroundColor3 = Color3.fromRGB(35, 22, 60)
	btn.TextColor3 = C.lightGray
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 10
	btn.Text = name
	btn.LayoutOrder = i
	btn.BorderSizePixel = 0
	btn.Parent = animScroll
	corner(btn, 6)
	stroke(btn, C.borderPurple, 0.7)

	btn.Activated:Connect(function()
		local ok = applyPack(name)
		animCurrentLbl.Text = ok and ("Current: " .. name) or ("Current: (failed) " .. name)
	end)
	animButtonsByName[name] = btn
end
refreshAnimCanvas()

local function filterAnimPacks(text)
	text = (text or ""):lower()
	for name, btn in pairs(animButtonsByName) do
		btn.Visible = (text == "") or (name:lower():find(text, 1, true) ~= nil)
	end
	refreshAnimCanvas()
end

animSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
	filterAnimPacks(animSearchBox.Text)
end)

local function checkAndAutoMorph()
	for _, data in ipairs(SavedCharacters) do
		if data.auto then
			task.spawn(function()
				local char = P.Character or P.CharacterAdded:Wait()
				local root = char:WaitForChild("HumanoidRootPart", 10)
				if not root then task.wait(1) end

				local ok, msg = doMorph(data.name)
				if ok then
					textBox.Text = data.name
					if activeTab == "morph" then
						updateProfileImage(data.name)
					end
					statusVal.Text = "Status: Auto-morphed into @" .. data.name
					statusVal.TextColor3 = Color3.fromRGB(105, 245, 135)
				else
					statusVal.Text = "Status: Auto-morph failed (" .. msg .. ")"
					statusVal.TextColor3 = Color3.fromRGB(255, 60, 60)
				end
			end)
			break
		end
	end
end

