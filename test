local activePreviewTrack = nil

local function updateStateButtonColors()
	for name, btn in pairs(stateButtons) do
		local selected = (name == currentPreviewState)
		btn.BackgroundColor3 = selected and C.buttonPurple or C.cardDark
		btn.TextColor3 = selected and C.lightGray or C.mutedGray
	end
end

stopPreviewTrack = function()
	if activePreviewTrack then
		pcall(function() activePreviewTrack:Stop(0.1) end)
		activePreviewTrack = nil
	end
end

local function positionCameraOnRig(rig)
	local root = rig and (rig:FindFirstChild("HumanoidRootPart") or rig:FindFirstChild("UpperTorso") or rig:FindFirstChild("Torso"))
	if not root then return end
	local camPos = root.Position + (root.CFrame.LookVector * 8.2) + Vector3.new(0, 0.4, 0)
	vpCamera.CFrame = CFrame.lookAt(camPos, root.Position + Vector3.new(0, 0.1, 0))
end

local function getPackAnimIdForState(packName, stateName)
	local pack = PACKS[packName]
	if not pack then return nil end

	if stateName == "Run" then
		return pack.RunAnim or pack.Run or pack.WalkAnim or pack.Walk
	elseif stateName == "Jump" then
		return pack.JumpAnim or pack.Jump or pack.FallAnim or pack.Fall
	else
		if type(pack.Idle) == "table" and #pack.Idle > 0 then
			return pack.Idle[1]
		end
		return pack.Animation1 or pack.Animation2 or pack.WalkAnim or pack.Walk
	end
end

previewPlayPackAnim = function(packName, stateName)
	if packName then lastAppliedPackName = packName end
	if stateName then currentPreviewState = stateName end
	updateStateButtonColors()

	stopPreviewTrack()
	if not previewAnimator or not lastAppliedPackName then return end

	local animId = getPackAnimIdForState(lastAppliedPackName, currentPreviewState)
	if not animId then return end

	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. tostring(animId)
	local ok, track = pcall(function() return previewAnimator:LoadAnimation(anim) end)
	if ok and track then
		track.Looped = true
		track:Play(0.15)
		activePreviewTrack = track
	end
end

for idx, sName in ipairs(stateNames) do
	local btn = Instance.new("TextButton")
	btn.Position = UDim2.new((idx - 1) / 3, idx == 1 and 0 or 2, 0, 0)
	btn.Size = UDim2.new(1 / 3, idx == 2 and -4 or -2, 1, 0)
	btn.BackgroundColor3 = (sName == currentPreviewState) and C.buttonPurple or C.cardDark
	btn.TextColor3 = (sName == currentPreviewState) and C.lightGray or C.mutedGray
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 9
	btn.Text = sName
	btn.BorderSizePixel = 0
	btn.Parent = stateBar
	corner(btn, 5)
	stroke(btn, C.borderPurple, 0.7)

	btn.Activated:Connect(function()
		currentPreviewState = sName
		updateStateButtonColors()
		if lastAppliedPackName then
			previewPlayPackAnim(lastAppliedPackName, sName)
		end
	end)

	stateButtons[sName] = btn
end

sync3DAvatarModel = function(sourceModel)
	stopPreviewTrack()
	if previewModel then
		previewModel:Destroy()
		previewModel = nil
		previewAnimator = nil
	end

	local target = sourceModel or P.Character
	if not target then return end

	pcall(function() target.Archivable = true end)
	local ok, clone = pcall(function() return target:Clone() end)
	if not ok or not clone then return end

	clone.Name = "Synapse3DPreviewRig"
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.Massless = true
		end
	end

	local root = clone:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = true
		clone.PrimaryPart = root
		clone:PivotTo(CFrame.new(0, 0, 0))
	end

	clone.Parent = worldModel
	previewModel = clone

	local hum = clone:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
		animator.Parent = hum
		previewAnimator = animator
	end

	positionCameraOnRig(clone)

	if lastAppliedPackName and PACKS[lastAppliedPackName] then
		previewPlayPackAnim(lastAppliedPackName, currentPreviewState)
	end
end

